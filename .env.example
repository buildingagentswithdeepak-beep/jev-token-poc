# Generation provider: authenticated GitHub Copilot CLI/SDK (no Anthropic API key).
MODEL_PROVIDER=github-copilot
# This Enterprise policy currently exposes only `auto`; effective model is captured per call.
COPILOT_MODEL=auto

# Jev decision provider
JEV_MODE=mock
JEV_API_KEY=
# JevStation metered endpoint; use direct TypeSafe endpoint only with a matching key.
JEV_ENDPOINT=https://jevstation.com/api/v1/systemone
